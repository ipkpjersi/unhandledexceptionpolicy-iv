<?xml version="1.0" encoding="utf-8"?>
<!--
  Keeps an unhandled exception on a background thread from killing GTA IV.

  LCPDFR's AudioHelper starts bare threads that call into SoundEngine. When the
  DirectSound device cannot be created, that throw reaches the top of a thread with no
  handler, and since .NET 2.0 the runtime terminates the process for that. Under .NET
  1.x such an exception was swallowed and only that thread died. This switch restores
  the old behaviour, turning the crash to desktop into a dead audio thread.

  See TODO.md item 2. This does not fix the underlying leak; it stops the leak from
  taking the whole game down. ScriptHookDotNet hosts CLR v4.0.30319 through
  ICLRRuntimeHost, and the setting is process wide, read from the executable's config.

  Deleting this file fully reverts it. GTA IV itself is native and never reads it.
-->
<configuration>
  <runtime>
    <legacyUnhandledExceptionPolicy enabled="1" />
  </runtime>
</configuration>
